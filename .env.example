# Copy this file to .env and fill it locally. Never commit a real API key.
MATAGENT_LLM_MODE=deepseek
MATAGENT_LLM_API_KEY=
MATAGENT_LLM_MODEL=deepseek-v4-flash
MATAGENT_LLM_BASE_URL=https://api.deepseek.com

# Optional real scientific-data backend.
MATAGENT_MATERIAL_BACKEND=mock
MATAGENT_MP_API_KEY=
MATAGENT_MP_BASE_URL=https://api.materialsproject.org
MATAGENT_MP_FETCH_LIMIT=100
MATAGENT_MP_TIMEOUT_SECONDS=20

# Supabase HTTPS Data API for hosted PostgreSQL + pgvector.
MATAGENT_SUPABASE_URL=
MATAGENT_SUPABASE_SECRET_KEY=
